{
  "name": "privacyaudit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 80",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:db": "tsx --test --test-concurrency=2 tests/database.test.ts tests/workflow.test.ts tests/evidence.test.ts tests/phase6.test.ts tests/admin-accounts.test.ts tests/memberships.test.ts tests/account-management.test.ts tests/account-profile.test.ts tests/organizations.test.ts tests/controls.test.ts",
    "test:ui": "tsx scripts/check-ui.ts",
    "test:ui:evidence": "tsx scripts/check-evidence-ui.ts",
    "types:local": "tsx scripts/generate-types.ts",
    "format": "prettier --write src tests scripts docs README.md AGENTS.md package.json tsconfig.json next.config.ts eslint.config.mjs postcss.config.mjs components.json compose.yaml",
    "test:ui:phase6": "tsx scripts/check-phase6-ui.ts",
    "test:ui:accounts": "tsx scripts/check-admin-accounts-ui.ts",
    "test:ui:account-profile": "tsx scripts/check-account-profile-ui.ts",
    "test:ui:memberships": "tsx scripts/check-memberships-ui.ts",
    "test:ui:organizations": "tsx scripts/check-organizations-ui.ts",
    "test:ui:controls": "tsx scripts/check-controls-ui.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-slot": "1.2.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.62.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.1.12",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module"
}
